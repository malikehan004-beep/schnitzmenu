    {
     "id": "00f763e",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li><strong>Kiddy Schnugget Pack</strong> &#8211; bite-size schnitzel pieces (schnuggets), mini chips and a drink.</li><li><strong>Teeny Weeny</strong> &#8211; a small burger or wrap with schnitzel, tomato sauce and cheese, plus mini chips and a Pop Top.</li></ul><p>Kids meals use the same crumbs as the main menu, so the same allergen rules apply. See the allergen guide if your child has a food allergy.</p>"
     },
     "elements": []
    }
   ],
