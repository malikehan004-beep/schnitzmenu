    {
     "id": "026d5f5",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li><strong>Information you give us</strong> &#8211; such as your name and email when you contact us or subscribe to updates.</li><li><strong>Usage information</strong> &#8211; pages visited, device and browser type, and approximate location, collected through cookies and analytics tools such as Google Analytics.</li></ul>"
