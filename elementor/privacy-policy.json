     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>This policy explains how SchnitzMenu.com (we, us) handles personal information. We follow the Australian Privacy Principles in the Privacy Act 1988 (Cth). By using this site you agree to this policy.</p>"
