    {
     "id": "6f54d46",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li><strong>Egg:</strong> used in traditional crumbing. Ask about crumb-free options.</li><li><strong>Milk:</strong> present in traditional crumbs, the buttermilk breader, cheese and many sauces.</li><li><strong>Soy:</strong> listed in traditional crumbs and some sauces.</li><li><strong>Sesame:</strong> listed in traditional crumbs and often in burger buns.</li></ul>"
