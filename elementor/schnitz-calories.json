    {
     "id": "0dc5569",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "How to Order a Lighter Meal at Schnitz",
      "header_size": "h2"
     },
     "elements": []
    },
    {
     "id": "fd5f33c",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li><strong>Swap chips for salad.</strong> Chips add several hundred calories to any plate.</li><li><strong>Go for a salad with schnitzel.</strong> You still get the schnitzel without the bun or wrap.</li><li><strong>Try a crumb-free flavour.</strong> Lemon pepper or Moroccan spices skip the crumb coating.</li><li><strong>Watch the sauces.</strong> Creamy mayo and aioli add up quickly. Ask for sauce on the side.</li><li><strong>Share the tenders.</strong> One original tender is about 152 calories.</li><li><strong>Choose water.</strong> A 600ml soft drink can add around 250 calories.</li></ul>"
     },
     "elements": []
    }
   ],
