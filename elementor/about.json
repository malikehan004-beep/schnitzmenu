    {
     "id": "f029875",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "How We Collect and Check Prices",
      "header_size": "h2"
     },
     "elements": []
    },
    {
     "id": "6b1b84e",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li>We gather prices from public sources, store listings and delivery apps.</li><li>Every price is marked <em>(approx.)</em> because prices vary between stores, states and ordering methods.</li><li>Where we cannot confirm a price or calorie figure, we say so instead of guessing.</li><li>We review the data at the start of every month and update the date shown on each page.</li></ul>"
     },
     "elements": []
    }
   ],
   "isInner": false
