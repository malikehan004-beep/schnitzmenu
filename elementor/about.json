   "elements": [
    {
     "id": "21fb284",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "Who We Are",
      "header_size": "h2"
     },
     "elements": []
    },
    {
     "id": "7cc6d56",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>The site is run by RK Mohsin, a website publisher focused on helpful, easy-to-read food guides. We are fans of the food, not employees of the company. We are not affiliated with, endorsed by or sponsored by Schnitz International Pty Ltd.</p>"
     },
     "elements": []
    }
   ],
   "isInner": false
