    {
     "id": "f08277a",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "Why We Built This Guide",
      "header_size": "h2"
     },
     "elements": []
    },
    {
     "id": "1b5bc19",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>SchnitzMenu.com is an independent, unofficial guide to the Schnitz menu in Australia. We built it because finding simple answers &#8211; how much a parma costs, how many calories are in a wrap, which crumbs contain egg &#8211; meant digging through delivery apps, PDFs and old forum posts. We wanted one clear, fast page that answered those questions properly.</p>"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
