      "header_size": "h2"
     },
     "elements": []
    },
    {
     "id": "3eba01d",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<ul><li><strong>Location.</strong> Airport, stadium and CBD stores often charge more to cover higher rent.</li><li><strong>Pickup vs delivery.</strong> Delivery menus are commonly 15&#8211;30% higher than in-store prices.</li><li><strong>State.</strong> Wages and supply costs vary between states, so do prices.</li><li><strong>Deals.</strong> App-only and limited-time bundles can be much cheaper than ordering items separately.</li></ul><p>Tip: if you are feeding a family, compare the bundle price against ordering items one by one using the meal builder on this page.</p>"
     },
     "elements": []
    }
   ],
